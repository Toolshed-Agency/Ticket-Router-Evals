# Copy to .env and fill in. Never commit .env: it is gitignored, and CI scans for leaked keys.
# Only names live here, never values.

# Google AI Studio API key, from a project with no billing account attached (free tier only).
# Used by the phase 1 probes now, and by the routers and judge later.
GEMINI_API_KEY=

# Cloudflare account id and an API token limited to Workers AI.
# Used by the phase 1 Workers AI probe.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
