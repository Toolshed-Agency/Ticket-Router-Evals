{
  "$defs": {
    "Language": {
      "description": "The language the customer wrote in. Each label is defined in docs/labeling-guide.md.",
      "enum": [
        "en",
        "ur",
        "roman_ur",
        "mixed"
      ],
      "title": "Language",
      "type": "string"
    },
    "Team": {
      "description": "The primary owner of a ticket. Each team is defined in docs/labeling-guide.md.",
      "enum": [
        "billing",
        "technical",
        "sales",
        "refunds",
        "account_security",
        "other"
      ],
      "title": "Team",
      "type": "string"
    },
    "Urgency": {
      "description": "How urgent a ticket is. Each level is defined in docs/labeling-guide.md.",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "Urgency",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One routing decision. \"P1 means escalate\" is measured, not enforced (section 6).",
  "properties": {
    "draft_reply": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Draft Reply",
      "type": "string"
    },
    "escalate_to_human": {
      "title": "Escalate To Human",
      "type": "boolean"
    },
    "issues": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Issues",
      "type": "array"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "reasoning": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reasoning",
      "type": "string"
    },
    "team": {
      "$ref": "#/$defs/Team"
    },
    "urgency": {
      "$ref": "#/$defs/Urgency"
    }
  },
  "required": [
    "team",
    "urgency",
    "escalate_to_human",
    "issues",
    "language",
    "draft_reply",
    "reasoning"
  ],
  "title": "RouterOutput",
  "type": "object"
}
